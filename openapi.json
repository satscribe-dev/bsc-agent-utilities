    "/v1/qr": {
      "get": {
        "operationId": "generateQr",
        "summary": "QR code PNG generator",
        "x-payment-info": {
          "scheme": "exact",
          "network": "eip155:8453",
          "asset": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
          "amount": "1000",
          "payTo": "0x3B5eC5a983576FCD98275Ff1604a1182ec5B5617",
          "description": "$0.001 USDC on Base per call"
        },
        "parameters": [
          {
            "name": "text",
            "in": "query",
            "required": true,
            "description": "Text to encode into the QR code PNG",
            "schema": {
              "type": "string",
              "description": "Text to encode into the QR code PNG",
              "example": "hello"
            },
            "example": "hello"
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "QR image size in pixels, e.g. 200x200 (default 200x200, max 1000)",
            "schema": {
              "type": "string",
              "description": "QR image size in pixels, e.g. 200x200 (default 200x200, max 1000)",
              "example": "200x200"
            },
            "example": "200x200"
          }
        ],
        "responses": {
          "200": {
            "description": "QR code PNG image (paid)",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Missing text param"
          },
          "402": {
