{
  "openapi": "3.1.0",
  "info": {
    "title": "BSC Agent Utilities",
    "version": "2.0.0",
    "contact": {
      "name": "BSC Agent Utilities",
      "email": "raninndia@gmail.com"
    },
    "description": "Cheap lookups for AI agents, pay per call in USDC on Base via x402, no API key: BSC gas + block tip $0.001, token price $0.001, tx status $0.001, contract safety check $0.001, email check $0.001, IP lookup $0.001, domain WHOIS $0.001, QR code PNG $0.001."
  },
  "servers": [
    {
      "url": "https://bsc-agent-utilities.raninndia.workers.dev"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "healthCheck",
        "summary": "Free health check",
        "description": "Free health check, no payment required. Lists all paid routes and their prices.",
        "security": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/gas": {
      "get": {
        "operationId": "getGasPrice",
        "summary": "BSC gas price + latest block",
        "description": "Returns the current BSC gas price, latest block number and estimated transaction costs in BNB. No input parameters.",
        "parameters": [],
        "x-payment-info": {
          "scheme": "exact",
          "network": "eip155:8453",
          "asset": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
          "amount": "1000",
          "payTo": "0x3B5eC5a983576FCD98275Ff1604a1182ec5B5617",
          "description": "$0.001 USDC on Base per call"
        },
        "responses": {
          "200": {
            "description": "Gas price, block tip, tx costs in BNB (paid)"
          },
          "402": {
            "description": "Payment required - $0.001 USDC on Base"
          }
        }
      }
    },
    "/v1/token-price": {
      "get": {
        "operationId": "getTokenPrice",
        "summary": "Token price via DexScreener (BSC-first)",
        "x-payment-info": {
          "scheme": "exact",
          "network": "eip155:8453",
          "asset": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
          "amount": "1000",
          "payTo": "0x3B5eC5a983576FCD98275Ff1604a1182ec5B5617",
          "description": "$0.001 USDC on Base per call"
        },
        "parameters": [
          {
            "name": "address",
            "in": "query",
            "required": true,
            "description": "BSC contract or token address (0x-prefixed, 42 chars)",
            "schema": {
              "type": "string",
              "description": "BSC contract or token address (0x-prefixed, 42 chars)",
              "example": "0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c"
            },
            "example": "0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c"
          }
        ],
        "responses": {
          "200": {
            "description": "Token price, market cap, liquidity (paid)"
          },
          "402": {
            "description": "Payment required - $0.001 USDC on Base"
          }
        }
      }
    },
