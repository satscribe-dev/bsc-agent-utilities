        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "description": "Email address to validate (format, MX records, disposable-domain check)",
            "schema": {
              "type": "string",
              "description": "Email address to validate (format, MX records, disposable-domain check)",
              "example": "hello@example.com"
            },
            "example": "hello@example.com"
          }
        ],
        "responses": {
          "200": {
            "description": "Email validation result (paid)"
